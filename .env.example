# ---------------------------------------------------------------------------
# RAG MCP Platform configuration template (Azure OpenAI).
# Copy to .env and fill in the REQUIRED values.
# Do NOT put inline comments after a value; put notes on their own line.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# Point this at your existing PostgreSQL instance. The `vector` extension must
# be available. Create the tables first with sql/schema.sql (see README).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@your-host:5432/your_database

# ---------------------------------------------------------------------------
# Azure OpenAI service credentials (used for BOTH embeddings and the LLM).
# REQUIRED: AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01

# ---------------------------------------------------------------------------
# Embeddings via Azure OpenAI
#   AZURE_EMBEDDING_DEPLOYMENT = the name of your Azure embedding deployment (REQUIRED).
#   EMBEDDING_MODEL            = the underlying model (drives dimension support).
#   EMBEDDING_DIM              = MUST match the vector(N) column in sql/schema.sql.
#   NOTE: pgvector's HNSW index supports at most 2000 dimensions, so we request
#         1536 (text-embedding-3-large supports reduced dims via `dimensions`).
#         text-embedding-3-large native = 3072 (needs halfvec or no ANN index).
#         text-embedding-3-small native = 1536.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=azure
AZURE_EMBEDDING_DEPLOYMENT=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=32
# Optional tag for the embedding model version. Azure does not need it for API
# calls (the deployment pins the version), but bumping it here forces ingestion
# to re-embed all documents so the whole index stays in one vector space.
EMBEDDING_VERSION=

# ---------------------------------------------------------------------------
# Answer LLM via Azure OpenAI (used by the web app and `rag-mcp-platform ask`).
#   AZURE_LLM_DEPLOYMENT = the name of your Azure chat/completions deployment (REQUIRED).
# ---------------------------------------------------------------------------
LLM_PROVIDER=azure
AZURE_LLM_DEPLOYMENT=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Optional Langfuse tracing
# Set LANGFUSE_ENABLED=true and provide credentials to export traces.
# ---------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Retrieval / hybrid search
# ---------------------------------------------------------------------------
TOP_K=8
CANDIDATE_COUNT=50
RRF_K=60
RERANK_ENABLED=false

# ---------------------------------------------------------------------------
# Chunking / ingestion
# ---------------------------------------------------------------------------
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
DOCS_SOURCE_DIR=docs-source

# ---------------------------------------------------------------------------
# Hosted MCP (streamable HTTP) — used by rag-mcp-platform-mcp-http
# Locally these are read from this file. In Docker, set RAG_MCP_PLATFORM_RUNTIME=container
# and inject the same variables as OS env vars (see docker/mcp/.env.example).
# ---------------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8080
# Optional: clients send Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=
# Stateful HTTP sessions (default false) — required for reliable VS Code reconnects.
# MCP_STATELESS_HTTP=true
# Optional SSE retry hint to clients (milliseconds).
# MCP_SSE_RETRY_INTERVAL_MS=30000
