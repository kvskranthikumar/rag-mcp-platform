# Runtime secrets for the hosted MCP container.
# Inject at deploy time via --env-file, -e, Kubernetes secrets, or ACA settings.
# Do NOT bake this file into the image.
#
# RAG_MCP_PLATFORM_RUNTIME=container is set in the Dockerfile; do not override unless
# you intentionally want dotenv loading inside the container.

# --- Required: PostgreSQL (pgvector schema — run sql/schema.sql first) ---
DATABASE_URL=postgresql://user:password@your-host:5432/your_database

# --- Required: Azure OpenAI embeddings (query-time retrieval) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
EMBEDDING_PROVIDER=azure
AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

# --- Optional: protect the MCP HTTP endpoint ---
# Clients send: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# --- Optional Langfuse tracing (set true and provide credentials to enable) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- HTTP bind (defaults set in Dockerfile; override if needed) ---
# MCP_HOST=0.0.0.0
# MCP_PORT=8080
# Stateful sessions (default) — keep false for VS Code / Copilot behind a proxy.
# MCP_STATELESS_HTTP=true
# MCP_SSE_RETRY_INTERVAL_MS=30000

# --- Retrieval tuning (optional) ---
TOP_K=8
CANDIDATE_COUNT=50
RRF_K=60
