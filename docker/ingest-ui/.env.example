# Copy to repo-root .env, then:
#   docker run --rm -p 8080:8080 --env-file .env rag-mcp-platform-ingest-ui
# Do NOT commit real secrets. Inject via --env-file, -e, or your orchestrator's secret store.

# --- Required: PostgreSQL (pgvector schema must exist — run sql/schema.sql first) ---
DATABASE_URL=postgresql://user:password@your-host:5432/your_database

# --- Required for ingestion (embeddings via Azure OpenAI) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
EMBEDDING_PROVIDER=azure
AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_VERSION=

# --- Not used by ingest UI, but safe to set if you share one .env across services ---
LLM_PROVIDER=azure
AZURE_LLM_DEPLOYMENT=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- Optional Langfuse tracing (set true and provide credentials to enable) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Chunking (optional) ---
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# --- Reverse proxy path prefix (required when the proxy forwards a sub-path) ---
# A reverse proxy serving the app under /documents/ingestion needs:
# STREAMLIT_SERVER_BASE_URL_PATH=documents/ingestion
